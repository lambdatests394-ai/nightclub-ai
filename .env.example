APP_ENV=development
APP_NAME=nightclub-ai
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=
PUBLIC_APP_URL=

# Runtime login only; never an administrator or the migration-validation role.
DATABASE_URL=
DATABASE_RUNTIME_EXPECTED_ROLE=nightclub_api
# Explicit DDL credential. Alembic never falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ALLOWED_ALGORITHMS=["ES256"]
JWT_CLOCK_SKEW_SECONDS=60
SUPABASE_JWKS_CACHE_TTL_SECONDS=300
STORAGE_BUCKET=nightclub-assets

CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_WEBHOOK_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=
META_PAGE_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=

OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_DEFAULT_PROVIDER=
AI_MAX_OUTPUT_TOKENS=
AI_DAILY_BUDGET_USD=

N8N_BASE_URL=
N8N_OUTBOUND_WEBHOOK_URL=
N8N_INTERNAL_SECRET=
INTERNAL_CALL_MAX_SKEW_SECONDS=

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
RAILWAY_ENVIRONMENT=
